# Copie para .env e ajuste. Usado pelo docker-compose e pelo perfil `postgres`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financeapp
DB_USER=financeapp
# Obrigatoria: escolha uma senha propria (o docker compose nao sobe sem ela).
DB_PASSWORD=

# Segredo que assina os tokens JWT (minimo 32 caracteres). Precisa ser aleatorio:
# o tamanho sozinho nao garante seguranca. Gere com: openssl rand -base64 48
JWT_SECRET=
