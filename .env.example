# Copie para .env e ajuste. Usado pelo docker-compose e pelo perfil `postgres`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financeapp
DB_USER=financeapp
DB_PASSWORD=financeapp

# Segredo que assina os tokens JWT (minimo 32 caracteres). Gere um valor proprio,
# por exemplo com: openssl rand -base64 48
JWT_SECRET=
